# Railway AI-service variables. Do not commit real keys.

LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=REPLACE_ME

# Free `edge` TTS needs no key. Keep STT mock unless Deepgram is configured.
TTS_PROVIDER=edge
STT_PROVIDER=mock
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Must match the backend value.
AI_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_STRING
ALLOWED_ORIGINS=https://app.example.com

PORT=8001
