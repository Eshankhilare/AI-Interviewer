# Railway backend variables (copy into the Railway service Variables UI).
# Do not commit real values.

SPRING_PROFILES_ACTIVE=production

# TiDB Cloud Starter (MySQL compatible). Create the database once in the
# TiDB SQL editor: CREATE DATABASE ai_interviewer;
SPRING_DATASOURCE_URL=jdbc:mysql://HOST:4000/ai_interviewer?useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=REPLACE_ME
SPRING_DATASOURCE_PASSWORD=REPLACE_ME

# 32+ random bytes: openssl rand -base64 48
JWT_SECRET=REPLACE_ME

# Railway private networking. Use the service name exactly as created.
# If you prefer the generated domain, use its https URL instead.
AI_SERVICE_URL=http://ai-service.railway.internal:8001
AI_SERVICE_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_STRING
AI_SERVICE_TIMEOUT_MS=120000

# Public site + Google OAuth
FRONTEND_URL=https://app.example.com
APP_CORS_ALLOWED_ORIGINS=https://app.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

# Ephemeral on Railway; parsed resume text is stored in the database.
UPLOAD_DIR=./uploads

# Keep the JVM inside a 1 GB service.
JAVA_TOOL_OPTIONS=-Xmx512m
PORT=8080
