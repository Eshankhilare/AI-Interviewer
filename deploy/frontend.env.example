# Cloudflare Pages build-time variables (Settings -> Environment variables).
# Vite inlines these at build time; changing one requires a redeploy.

VITE_API_URL=https://api.example.com
VITE_CONTACT_EMAIL=team@example.com
VITE_CONTACT_PHONE=

# Keep the build on a current Node; Vite 6 does not support old Node 18 builds.
NODE_VERSION=20
