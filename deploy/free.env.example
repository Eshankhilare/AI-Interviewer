# Free-only Oracle VM stack. Copy to .env at the repo root and fill the values.
# Never commit this file.

# A real domain, or an sslip.io name that maps to your public IP:
#   203.0.113.10 -> 203-0-113-10.sslip.io
APP_DOMAIN=203-0-113-10.sslip.io

DB_PASSWORD=REPLACE_ME
DB_ROOT_PASSWORD=REPLACE_ME

# openssl rand -base64 48
JWT_SECRET=REPLACE_ME

# openssl rand -hex 32
AI_SERVICE_TOKEN=REPLACE_ME

# Gemini key from https://aistudio.google.com/apikey
LLM_API_KEY=REPLACE_ME
LLM_MODEL=gemini-3.5-flash-lite

# Shown on the legal pages; leave the phone empty to hide it.
CONTACT_EMAIL=
CONTACT_PHONE=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
