# Backend configuration (copy to backend/.env or export in your shell)
# Spring Boot reads these as environment variables; do not commit real values.

# Required in production (32+ bytes). Leave empty locally to use a random per-run key.
JWT_SECRET=

# Database (defaults target local MySQL; the "local" profile uses in-memory H2 instead)
DB_USERNAME=root
DB_PASSWORD=

# AI service
AI_SERVICE_URL=http://localhost:8001
# Must match AI_SERVICE_TOKEN in ai-service/.env. Empty = open (local only).
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=30000

# Where uploaded resumes are stored (ephemeral on Render free tier)
UPLOAD_DIR=./uploads

# Comma-separated browser origins allowed to call the API
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Code execution (Judge0)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=

# Optional
PORT=8080
